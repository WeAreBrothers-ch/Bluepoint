{%- comment -%}
  « À découvrir aussi » : les autres bouteilles de la boutique (4 au plus), dans la même grille de cellules que
  la sélection de l’accueil (2 sur téléphone, 3 sur tablette, 4 sur ordinateur : assets/bp-product-extras.css).
  Plus de rangée qui défile sur le côté : tout se voit d’un coup d’œil.
  Paramètres : product, section_id
{%- endcomment -%}
{%- liquid
  assign shown = 0
  assign others_count = collections.all.products_count | minus: 1
  assign title_id = 'bp-autres-title-' | append: section_id
-%}
{%- if others_count > 0 -%}
  <section class="bp-section bp-section--grille bp-more" aria-labelledby="{{ title_id }}">
    {%- render 'bp-section-head',
      id: title_id,
      title: 'À découvrir aussi',
      link_url: routes.all_products_collection_url,
      link_label: 'Toutes les bouteilles'
    -%}
    <ul class="bp-grille bp-more__grid">
      {%- for other in collections.all.products -%}
        {%- if other.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        <li>
          {%- render 'bp-product-card',
            product: other,
            teinte: forloop.index,
            sizes: '(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw'
          -%}
        </li>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}