{%- comment -%}
  « De l’apéritif au dessert » : les accords mets-vins de la bouteille.
  Source : métachamp bluepoint.accords (liste d'entrées « bp_accord » : moment, plat, pourquoi).
  Masqué si le produit n'a aucun accord.
  Paramètres : product, section_id
{%- endcomment -%}
{%- assign accords = product.metafields.bluepoint.accords.value -%}
{%- if accords != blank and accords.size > 0 -%}
  {%- assign title_id = 'bp-accords-title-' | append: section_id -%}
  <section class="bp-pairings" aria-labelledby="{{ title_id }}">
    {%- render 'bp-section-head', id: title_id, title: "De l’apéritif au dessert" -%}
    <p class="bp-pairings__intro">
      {%- if accords.size == 3 -%}Trois moments{%- else -%}Les moments{%- endif %} de la table où
      {{ product.title | escape }} trouve sa place, choisis par Paolo.
    </p>
    <ol class="bp-pairings__list">
      {%- for accord in accords -%}
        <li class="bp-pairings__item">
          <p class="bp-ui bp-pairings__moment">{{ accord.moment.value | escape }}</p>
          <h3 class="bp-affiche bp-pairings__dish">{{ accord.plat.value | escape }}</h3>
          {%- if accord.pourquoi.value != blank -%}
            <p class="bp-phrase bp-pairings__why">{{ accord.pourquoi.value | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </section>
{%- endif -%}
