{%- comment -%}
  En-tête de section : un petit libellé de rubrique facultatif, le titre centré, puis un lien en pilule « … + ».
  Paramètres : id, title, tag ('h1' ou 'h2', défaut h2), link_url, link_label, kicker (facultatif)
{%- endcomment -%}
{%- assign heading = tag | default: 'h2' -%}
<div class="bp-ui bp-section-head">
  {%- if kicker != blank -%}
    <p class="bp-rubrique">{{ kicker | escape }}</p>
  {%- endif -%}
  <{{ heading }} id="{{ id }}" class="bp-titre bp-section-head__title">{{ title | escape }}</{{ heading }}>
  {%- if link_url != blank and link_label != blank -%}
    <a href="{{ link_url }}" class="bp-section-head__link">
      {{ link_label | escape }}
      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false" class="bp-section-head__plus"><path d="M6 1v10M1 6h10" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
    </a>
  {%- endif -%}
</div>