{%- comment -%}
  Les rayons de la boutique, en haut de la grille, au plus léger possible :
  - « Type » : Tous, Rouges, Blancs…
  - « Origine » : seulement les pays (Toutes, Italie, Suisse…), pas toutes les régions d'un coup ;
  - « Région » : n'apparaît que lorsqu'un pays est choisi, avec les régions de ce pays.
  Les choix se combinent : « Rouges », « Italie » puis « Piémont » mène à /collections/all/rouge+region-piemont.
  Rien à régler : tout vient des produits (type de produit, étiquettes « pays:… » et « region:… »).
  Paramètres : current_type (handle du type choisi ou vide), current_place (handle de l'origine choisie ou vide)
  Limite : les 50 premières bouteilles de la boutique servent à construire les rayons.
{%- endcomment -%}
{{ 'bp-shop-filters.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  assign products = collections.all.products
  capture types
    render 'bp-catalog-data', mode: 'types', products: products
  endcapture
  assign types = types | split: '|'

  # Les origines proposées : celles du type choisi, sinon toutes.
  assign place_products = products
  for type in types
    assign type_handle = type | handle
    if type_handle == current_type
      assign place_products = products | where: 'type', type
    endif
  endfor
  capture countries
    render 'bp-catalog-data', mode: 'countries', products: place_products
  endcapture
  assign countries = countries | split: '|'

  assign type_suffix = ''
  if current_type != blank
    assign type_suffix = '/' | append: current_type
  endif

  # Le pays « ouvert » : celui qui est choisi, ou celui de la région choisie. Ses régions s'affichent sur une 3e rangée.
  assign open_country = ''
  assign open_regions = nil
  for country in countries
    capture country_regions
      render 'bp-catalog-data', mode: 'regions', products: place_products, within: country
    endcapture
    assign regions_list = country_regions | split: '|'
    assign country_handle = country | handle
    if current_place == country_handle
      assign open_country = country
      assign open_regions = regions_list
    else
      for region in regions_list
        assign region_handle = region | handle
        if region_handle == current_place
          assign open_country = country
          assign open_regions = regions_list
        endif
      endfor
    endif
  endfor

  # Un seul pays en boutique : inutile de lui faire une rangée, ses régions s'affichent directement.
  assign show_countries = true
  if countries.size == 1
    assign show_countries = false
    if open_country == blank
      assign open_country = countries.first
      capture only_regions
        render 'bp-catalog-data', mode: 'regions', products: place_products, within: open_country
      endcapture
      assign open_regions = only_regions | split: '|'
    endif
  endif
-%}

<nav class="bp-ui bp-filters" aria-label="Rayons de la boutique">
  <div class="bp-filters__row" role="group" aria-labelledby="bp-filtres-type">
    <span class="bp-filters__label" id="bp-filtres-type">Type</span>
    <ul class="bp-filters__list">
      <li>
        <a class="bp-filters__pill" href="{% if current_place != blank %}{{ shop_url }}/{{ current_place }}{% else %}{{ shop_url }}{% endif %}" {% if current_type == blank %}aria-current="true"{% endif %}>Tous</a>
      </li>
      {%- for type in types -%}
        {%- liquid
          assign type_handle = type | handle
          assign type_url = shop_url | append: '/' | append: type_handle
          if current_place != blank
            assign type_url = type_url | append: '+' | append: current_place
          endif
        -%}
        <li>
          <a class="bp-filters__pill" href="{{ type_url }}" {% if current_type == type_handle %}aria-current="true"{% endif %}>
            {%- render 'bp-type-label', type: type -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if show_countries and countries.size > 0 -%}
    <div class="bp-filters__row" role="group" aria-labelledby="bp-filtres-origine">
      <span class="bp-filters__label" id="bp-filtres-origine">Origine</span>
      <ul class="bp-filters__list">
        <li>
          <a class="bp-filters__pill" href="{{ shop_url }}{{ type_suffix }}" {% if current_place == blank %}aria-current="true"{% endif %}>Toutes</a>
        </li>
        {%- for country in countries -%}
          {%- liquid
            assign country_handle = country | handle
            assign country_url = shop_url | append: '/'
            if current_type != blank
              assign country_url = country_url | append: current_type | append: '+'
            endif
            assign country_url = country_url | append: country_handle
          -%}
          <li>
            <a class="bp-filters__pill" href="{{ country_url }}" {% if current_place == country_handle %}aria-current="true"{% elsif open_country == country %}data-parent="true"{% endif %}>
              {{- country | remove_first: 'pays:' | strip | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if open_regions.size > 0 -%}
    <div class="bp-filters__row" role="group" aria-labelledby="bp-filtres-region">
      <span class="bp-filters__label" id="bp-filtres-region">Région</span>
      <ul class="bp-filters__list">
        {%- for region in open_regions -%}
          {%- liquid
            assign region_handle = region | handle
            assign region_url = shop_url | append: '/'
            if current_type != blank
              assign region_url = region_url | append: current_type | append: '+'
            endif
            assign region_url = region_url | append: region_handle
          -%}
          <li>
            <a class="bp-filters__pill" href="{{ region_url }}" {% if current_place == region_handle %}aria-current="true"{% endif %}>
              {{- region | remove_first: 'region:' | strip | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</nav>