{%- comment -%}
  Le sticker posé sur la photo de la fiche vin : une seule information, tirée des données de la bouteille
  (celles que « Modifier la fiche » de la page Stock de l'app enregistre) :
  - ce que la fiche a choisi (métachamp bluepoint.sticker) : « annee » montre l'année (étiquette « millesime:… »),
    « degre » montre le degré d'alcool (métachamp bluepoint.degre) ; changer l'année, le degré ou ce choix dans
    Stock change le sticker ;
  - sans choix enregistré (fiche pas encore ouverte depuis), ou si l'information choisie manque : le degré d'un
    spiritueux, sinon l'année, sinon le degré ;
  - le degré est précédé de « Vol. » pour qu'on ne le prenne pas pour une réduction : « VOL. 12 % », « VOL. 13,5 % » ;
  - sans année ni degré : pas de sticker.
  La couleur suit la robe du vin : grenat pour les rouges, rose pour les rosés, vert vigne pour les blancs et les
  pétillants, ciel pour le reste. Le texte répète la fiche d'identité : il reste décoratif pour les lecteurs d'écran.
  Paramètre : product
{%- endcomment -%}
{%- liquid
  assign texte = ''
  assign forme = 'feston'
  assign rotation = -6

  assign millesime = ''
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down contains 'millesime:'
      assign millesime = tag | remove_first: 'millesime:' | strip
    endif
  endfor

  assign degre = product.metafields.bluepoint.degre.value
  assign choix = product.metafields.bluepoint.sticker.value | append: ''
  assign montre = ''
  if choix == 'degre' and degre != blank
    assign montre = 'degre'
  elsif choix == 'annee' and millesime != blank
    assign montre = 'annee'
  elsif degre != blank and product.type == 'Spiritueux'
    # Un spiritueux montre son degré, même s'il porte une année.
    assign montre = 'degre'
  elsif millesime != blank
    assign montre = 'annee'
  elsif degre != blank
    assign montre = 'degre'
  endif

  if montre == 'annee'
    assign texte = millesime
  elsif montre == 'degre'
    assign degre_text = degre | append: ''
    assign degre_end = degre_text | slice: -2, 2
    if degre_end == '.0'
      assign degre_text = degre | round
    endif
    # Espace insécable entre le nombre et « % » : « 12 % » ne se coupe pas ; « Vol. » peut passer sur sa propre ligne.
    assign texte = degre_text | append: '' | replace: '.', ',' | prepend: 'Vol. ' | append: ' %'
  endif

  case product.type
    when 'Rouge'
      assign couleur = 'grenat'
    when 'Rosé'
      assign couleur = 'rose'
    when 'Blanc', 'Effervescent'
      assign couleur = 'vigne'
    else
      assign couleur = 'ciel'
  endcase
-%}
{%- render 'bp-sticker',
  forme: forme,
  texte: texte,
  couleur: couleur,
  rotation: rotation,
  taille: 'm',
  class: 'bp-sticker--fiche'
-%}
