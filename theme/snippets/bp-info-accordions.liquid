{%- comment -%}
  Blocs dépliables natifs (<details>) : clavier et lecteurs d'écran fonctionnent sans script.
  Un bloc dont le métachamp est vide n’est pas affiché.
  Texte simple : échappé, retours à la ligne conservés ; texte enrichi : rendu par Shopify (metafield_tag). Le premier bloc affiché est ouvert.
  Paramètres : product, delivery_text
{%- endcomment -%}
{%- liquid
  assign bp = product.metafields.bluepoint
  assign titles = 'Dégustation|Le domaine|Service|Conservation|Livraison' | split: '|'
  assign opened = false
-%}

<div class="bp-accordions">
  {%- for title in titles -%}
    {%- liquid
      assign field = nil
      case forloop.index
        when 1
          assign field = bp.degustation
        when 2
          assign field = bp.producteur
        when 3
          assign field = bp.service
        when 4
          assign field = bp.conservation
      endcase
      if field != nil
        assign body = field.value
      else
        assign body = delivery_text
      endif
      assign plain_text = true
      if field != nil and field.type != 'multi_line_text_field' and field.type != 'single_line_text_field'
        assign plain_text = false
      endif
    -%}
    {%- if body != blank -%}
      <details class="bp-accordions__item" {% unless opened %}open{% endunless %}>
        <summary class="bp-ui bp-accordions__summary">
          {{ title }}
          <span class="bp-accordions__state">
            <span class="bp-phrase bp-accordions__word" data-etat="ferme">Ouvrir</span>
            <span class="bp-phrase bp-accordions__word" data-etat="ouvert">Fermer</span>
            <span class="bp-accordions__icon" aria-hidden="true"></span>
          </span>
        </summary>
        {%- if plain_text -%}
          <p class="bp-accordions__body">{{ body | escape | newline_to_br }}</p>
        {%- else -%}
          <div class="bp-accordions__body">{{ field | metafield_tag }}</div>
        {%- endif -%}
      </details>
      {%- assign opened = true -%}
    {%- endif -%}
  {%- endfor -%}
</div>
