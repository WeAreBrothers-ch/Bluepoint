{%- comment -%}
  Menu téléphone et tablette : un panneau plein écran bleu (<dialog>, ouvert par le bouton « Menu » ; assets/bp-chrome.js),
  comme celui du site de référence : de grosses pastilles claires sur un fond de couleur. Pensé pour le pouce :
  1. le haut : le logo et « Fermer » ;
  2. une pastille par ligne : toute la boutique, puis un type de vin, avec le nombre de bouteilles ;
  3. trois volets à déplier (<details>, sans script) : producteurs de A à Z, pays et régions, cépages,
     chacun en petites pastilles (styles : assets/bp-menu-plis.css) ;
  4. le bas, toujours visible : une pastille bleu ciel, « Espace pro ».
  Accords, La maison, Wine bar, Instagram… ne sont plus ici : ils sont dans le pied de page.
  Paramètres : products, types, countries, shop_url, bottle_count, pro_url, pro_label, pro_active
{%- endcomment -%}
{%- liquid
  assign current_handles = '|'
  for tag in current_tags
    assign tag_handle = tag | handle
    assign current_handles = current_handles | append: tag_handle | append: '|'
  endfor
-%}
{{ 'bp-menu-plis.css' | asset_url | stylesheet_tag }}
<dialog class="bp-menu" aria-label="Menu" data-bp-menu>
  <div class="bp-menu__top">
    <a href="{{ routes.root_url }}" class="bp-menu__brand" aria-label="BluePoint, accueil">
      {% render 'bp-logo', class: 'bp-menu__logo' %}
    </a>
    <button type="button" class="bp-ui bp-carre bp-menu__close" data-bp-menu-close autofocus>Fermer</button>
  </div>

  <nav class="bp-menu__body" aria-label="Menu principal">
    <ul class="bp-menu__rows">
      <li>
        <a class="bp-ui bp-menu__row" href="{{ shop_url }}">
          <span class="bp-menu__label">Toute la boutique</span>
          <span class="bp-menu__count">{{ bottle_count }}<span class="bp-sr-only"> bouteilles</span></span>
        </a>
      </li>
      {%- for type in types -%}
        {%- liquid
          assign typed = products | where: 'type', type
          assign type_handle = type | handle
          assign type_marker = '|' | append: type_handle | append: '|'
        -%}
        <li>
          <a class="bp-ui bp-menu__row" href="{{ shop_url }}/{{ type_handle }}" {% if current_handles contains type_marker %}aria-current="page"{% endif %}>
            <span class="bp-menu__label">{% render 'bp-type-label', type: type %}</span>
            <span class="bp-menu__count">{{ typed.size }}<span class="bp-sr-only"> bouteille{% if typed.size > 1 %}s{% endif %}</span></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- liquid
      assign vendors = products | map: 'vendor' | uniq | sort_natural
      capture grapes
        render 'bp-cepages', products: products
      endcapture
      assign grapes = grapes | split: '|'
    -%}
    <details class="bp-menu__pli">
      <summary class="bp-ui bp-menu__pli-titre">Producteurs<span class="bp-menu__pli-signe" aria-hidden="true"></span></summary>
      <ul class="bp-menu__places">
        {%- for vendor in vendors -%}
          {%- if vendor == blank -%}{%- continue -%}{%- endif -%}
          <li><a class="bp-ui bp-menu__place" href="{{ vendor | url_for_vendor }}">{{ vendor | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </details>

    {%- if countries.size > 0 -%}
      <details class="bp-menu__pli">
        <summary class="bp-ui bp-menu__pli-titre">Pays et régions<span class="bp-menu__pli-signe" aria-hidden="true"></span></summary>
        {%- for country in countries -%}
          {%- liquid
            capture country_regions
              render 'bp-catalog-data', mode: 'regions', products: products, within: country
            endcapture
            assign country_regions = country_regions | split: '|'
          -%}
          <ul class="bp-menu__places">
            <li>
              <a class="bp-ui bp-menu__place bp-menu__place--country" href="{{ shop_url }}/{{ country | handle }}">
                {{- country | remove_first: 'pays:' | strip | escape -}}
              </a>
            </li>
            {%- for tag in country_regions -%}
              <li>
                <a class="bp-ui bp-menu__place" href="{{ shop_url }}/{{ tag | handle }}">{{ tag | remove_first: 'region:' | strip | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </details>
    {%- endif -%}

    {%- if grapes.size > 0 -%}
      <details class="bp-menu__pli">
        <summary class="bp-ui bp-menu__pli-titre">Cépages<span class="bp-menu__pli-signe" aria-hidden="true"></span></summary>
        <ul class="bp-menu__places">
          {%- for grape in grapes -%}
            <li><a class="bp-ui bp-menu__place" href="{{ routes.search_url }}?view=cepage&amp;q={{ grape | url_encode }}">{{ grape | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </details>
    {%- endif -%}
  </nav>

  <div class="bp-menu__foot">
    <a class="bp-ui bp-carre bp-menu__pro" href="{{ pro_url | escape }}" {% if pro_active %}aria-current="page"{% endif %}>{{ pro_label }}</a>
  </div>
</dialog>