{%- comment -%}
  Les textes de la fiche : chaque bloc est amené par un filet puis un intitulé court, et le texte suit.
  Ordre : la description (si elle existe), Dégustation, Le domaine, Service et conservation, puis la fiche d'identité
  (snippets/bp-product-identity.liquid). Un bloc dont le contenu est vide n'est pas affiché.
  La description et la dégustation sont toujours ouvertes. Les autres blocs sont des menus déroulants natifs (<details>) :
  fermés sur téléphone pour garder la fiche courte, ouverts sur grand écran par assets/bp-product-blocks.js.
  La livraison n'est pas répétée ici : elle est dans le bandeau d'annonce, tout en haut de la page.
  Paramètre : product
{%- endcomment -%}
{%- liquid
  assign bp = product.metafields.bluepoint
-%}
{%- capture tasting -%}{%- render 'bp-field-text', field: bp.degustation -%}{%- endcapture -%}
{%- capture domain -%}{%- render 'bp-field-text', field: bp.producteur -%}{%- endcapture -%}
{%- capture service -%}{%- render 'bp-field-text', field: bp.service -%}{%- render 'bp-field-text', field: bp.conservation -%}{%- endcapture -%}

<div class="bp-product-blocks">
  {%- if product.description != blank -%}
    <section class="bp-product-block" aria-label="Présentation">
      <div class="bp-product-block__text">{{ product.description }}</div>
    </section>
  {%- endif -%}

  {%- if tasting != blank -%}
    <section class="bp-product-block" aria-labelledby="bp-degustation-titre">
      <h2 class="bp-product-block__label" id="bp-degustation-titre">Dégustation</h2>
      <div class="bp-product-block__text">{{ tasting }}</div>
    </section>
  {%- endif -%}

  {%- if domain != blank -%}
    <details class="bp-product-block bp-product-block--pli" data-bp-pli>
      <summary class="bp-product-block__label">Le domaine<span class="bp-product-block__icon" aria-hidden="true"></span></summary>
      <div class="bp-product-block__text">{{ domain }}</div>
    </details>
  {%- endif -%}

  {%- if service != blank -%}
    <details class="bp-product-block bp-product-block--pli" data-bp-pli>
      <summary class="bp-product-block__label">Service et conservation<span class="bp-product-block__icon" aria-hidden="true"></span></summary>
      <div class="bp-product-block__text">{{ service }}</div>
    </details>
  {%- endif -%}

  {%- render 'bp-product-identity', product: product -%}
</div>
