{%- comment -%}
  Colonne d’information de la fiche : fil d'Ariane, nom, prix, description,
  achat, fiche technique et blocs dépliables.
  Paramètres : product, form_id, free_shipping_from, delivery_text
{%- endcomment -%}
{%- liquid
  assign bp = product.metafields.bluepoint
  assign region = bp.region.value
  assign cepage = bp.cepage.value

  assign volume_label = ''
  assign volume_ml = bp.volume_ml.value
  if volume_ml != blank
    assign volume_rest = volume_ml | modulo: 10
    if volume_rest == 0
      assign volume_label = volume_ml | divided_by: 10 | append: ' cl'
    else
      assign volume_label = volume_ml | divided_by: 10.0 | append: '' | replace: '.', ',' | append: ' cl'
    endif
  endif

  assign degre_label = ''
  assign degre = bp.degre.value
  if degre != blank
    assign degre_text = degre | append: ''
    assign degre_end = degre_text | slice: -2, 2
    if degre_end == '.0'
      assign degre_text = degre | round
    endif
    assign degre_label = degre_text | append: '' | replace: '.', ',' | append: ' % vol.'
  endif
-%}

<div class="bp-product-info">
  <nav aria-label="Fil d’Ariane" class="bp-ui bp-product-info__trail">
    <a href="{{ routes.all_products_collection_url }}" class="bp-carre bp-product-info__trail-link">Boutique</a>
    {%- if product.type != blank -%}
      <span aria-hidden="true">/</span>
      <span>{{ product.type | escape }}</span>
    {%- endif -%}
  </nav>

  <div class="bp-product-info__heading">
    <h1 class="bp-affiche bp-product-info__name">{{ product.title | escape }}</h1>
    <p class="bp-product-info__producer">
      {{- product.vendor | escape -}}
      {%- if region != blank %}, {{ region | escape }}{% endif -%}
    </p>
  </div>

  <div class="bp-product-info__pricing">
    <p class="bp-product-info__price">{% render 'bp-price', cents: product.price %}</p>
    {%- render 'bp-tax-note' -%}
    {%- render 'bp-price', mode: 'badge' -%}
  </div>

  {%- if product.description != blank -%}
    <div class="bp-product-info__description">{{ product.description }}</div>
  {%- endif -%}

  {%- render 'bp-buy-box', product: product, form_id: form_id, free_shipping_from: free_shipping_from -%}

  <dl class="bp-ui bp-product-info__facts">
    {%- if product.vendor != blank -%}
      <div class="bp-product-info__fact"><dt>Producteur</dt><dd>{{ product.vendor | escape }}</dd></div>
    {%- endif -%}
    {%- if region != blank -%}
      <div class="bp-product-info__fact"><dt>Origine</dt><dd>{{ region | escape }}</dd></div>
    {%- endif -%}
    {%- if cepage != blank -%}
      <div class="bp-product-info__fact"><dt>Cépage</dt><dd>{{ cepage | escape }}</dd></div>
    {%- endif -%}
    {%- if volume_label != blank -%}
      <div class="bp-product-info__fact"><dt>Contenance</dt><dd>{{ volume_label }}</dd></div>
    {%- endif -%}
    {%- if degre_label != blank -%}
      <div class="bp-product-info__fact"><dt>Degré</dt><dd>{{ degre_label }}</dd></div>
    {%- endif -%}
  </dl>

  {%- render 'bp-info-accordions', product: product, delivery_text: delivery_text -%}
</div>
