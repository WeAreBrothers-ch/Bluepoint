{%- comment -%}
  En-tête fixe BluePoint : la barre (logo, liens, panier), puis dessous un bandeau d'annonce bleu ciel
  (même ordre que le site de référence). Le logo est toujours à gauche.
  - Grand écran : les rayons en texte, centrés (aucun panneau qui s'ouvre au survol), « Espace pro » et « Panier »
    en texte à droite (snippets/bp-nav-desktop.liquid).
  - Téléphone et tablette : « Panier » puis « Menu » à droite (panneau plein écran : snippets/bp-nav-mobile.liquid).
  Le panier porte l'attribut data-bp-floating-cart : assets/bp-cart.js y met à jour le nombre de bouteilles.
  Les rayons se construisent seuls à partir des produits : type de produit (Rouge, Blanc…) et
  étiquettes « pays:… » et « region:… » (voir README, « Ranger une bouteille »).
  Limite : les 50 premières bouteilles de la boutique servent à construire les rayons.
{%- endcomment -%}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  assign products = collections.all.products
  assign bottle_count = collections.all.products_count
  assign pro_url = section.settings.pro_url | default: '/pages/espace-pro'
  assign pro_label = 'Espace pro'
  if customer and customer.b2b?
    assign pro_label = 'Mon espace pro'
  endif
  assign shop_active = false
  assign pro_active = false
  if template.suffix == 'espace-pro'
    assign pro_active = true
  endif
  if template.name == 'product' or template.name == 'collection' or template.name == 'list-collections'
    assign shop_active = true
  endif

  capture types
    render 'bp-catalog-data', mode: 'types', products: products
  endcapture
  capture regions
    render 'bp-catalog-data', mode: 'regions', products: products
  endcapture
  capture countries
    render 'bp-catalog-data', mode: 'countries', products: products
  endcapture
  assign types = types | split: '|'
  assign regions = regions | split: '|'
  assign countries = countries | split: '|'

  assign cart_label = 'Panier, vide'
  if cart.item_count == 1
    assign cart_label = 'Panier, 1 bouteille'
  elsif cart.item_count > 1
    assign cart_label = 'Panier, ' | append: cart.item_count | append: ' bouteilles'
  endif
-%}

<header class="bp-header">
  <div class="bp-header__bar">
    <a href="{{ routes.root_url }}" class="bp-header__brand" aria-label="BluePoint, accueil">
      {% render 'bp-logo', class: 'bp-header__logo' %}
    </a>

    {%- render 'bp-nav-desktop',
      types: types,
      shop_url: shop_url,
      shop_active: shop_active
    -%}

    <div class="bp-header__tools">
      <a class="bp-ui bp-header__cell bp-header__pro" href="{{ pro_url | escape }}" {% if pro_active %}aria-current="page"{% endif %}>{{ pro_label }}</a>
      <a
        href="{{ routes.cart_url }}"
        class="bp-ui bp-header__cell bp-header__cart"
        data-actif="{% if cart.item_count > 0 %}true{% else %}false{% endif %}"
        data-bp-floating-cart
        aria-label="{{ cart_label }}"
      >
        <span class="bp-header__cart-label">Panier</span>
        <span class="bp-eclat bp-header__burst" aria-hidden="true" data-bp-cart-count>{{ cart.item_count }}</span>
      </a>
      <button type="button" class="bp-ui bp-header__cell bp-menu__toggle" aria-haspopup="dialog" aria-expanded="false" data-bp-menu-open>
        Menu
      </button>
    </div>
  </div>
  {%- if section.settings.announcement != blank -%}
    <p class="bp-ui bp-phrase bp-header__annonce">
      <span class="bp-header__annonce-long">{{ section.settings.announcement | escape }}</span>
      <span class="bp-header__annonce-court">{{ section.settings.announcement_short | default: section.settings.announcement | escape }}</span>
    </p>
  {%- endif -%}
</header>

{%- render 'bp-nav-mobile',
  products: products,
  types: types,
  countries: countries,
  shop_url: shop_url,
  bottle_count: bottle_count,
  pro_url: pro_url,
  pro_label: pro_label,
  pro_active: pro_active
-%}

{% schema %}
{
  "name": "En-tête BluePoint",
  "tag": "div",
  "class": "bp-header-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Bandeau d’annonce",
      "info": "Affiché sous la barre de navigation, sur chaque page. Vide : pas de bandeau.",
      "default": "Livraison sous 48 h en Suisse, offerte dès 24 bouteilles"
    },
    {
      "type": "text",
      "id": "announcement_short",
      "label": "Bandeau d’annonce, version téléphone",
      "info": "Plus court, pour tenir sur une ligne sur un petit écran. Vide : le même texte que ci-dessus.",
      "default": "Livraison 48 h · offerte dès 24 bouteilles"
    },
    {
      "type": "text",
      "id": "pro_url",
      "label": "Lien Espace pro",
      "default": "/pages/espace-pro"
    }
  ]
}
{% endschema %}