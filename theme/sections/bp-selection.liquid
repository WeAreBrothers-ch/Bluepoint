{%- comment -%}
  « La sélection » : une grille de bouteilles, des cellules séparées par des filets de bord à bord.
  Les bouteilles retenues (les premières de la collection) sont classées par producteur, de A à Z.
  La dernière cellule invite les professionnels à l'espace pro et comble la fin de la rangée ;
  elle se masque avec le réglage « Afficher la cellule pro ».
  Rien n'est affiché tant que la collection est vide.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collections.all
  endif
  assign heading_id = 'bp-selection-title-' | append: section.id

  # Colonnes de la grille : 2 (téléphone), 3 (tablette), 4 (ordinateur). La dernière cellule prend ce qu'il reste de la rangée.
  assign shown = source.products.size
  if shown > s.limit
    assign shown = s.limit
  endif
  assign rest_2 = shown | modulo: 2
  assign rest_3 = shown | modulo: 3
  assign rest_4 = shown | modulo: 4
  assign span_2 = 2 | minus: rest_2
  assign span_3 = 3 | minus: rest_3
  assign span_4 = 4 | minus: rest_4

  capture vendor_order
    render 'bp-vendor-order', products: source.products, limit: s.limit
  endcapture
  assign vendor_order = vendor_order | strip | split: ','
-%}

{%- if source.products_count > 0 -%}
<section id="selection" class="bp-section bp-section--grille" aria-labelledby="{{ heading_id }}">
  {% render 'bp-section-head',
    id: heading_id,
    kicker: s.kicker,
    title: s.title,
    link_url: routes.all_products_collection_url,
    link_label: s.link_label,
    barre: true
  %}
  {%- render 'bp-sticker', forme: 'etoile', texte: 'good taste', couleur: 'vigne', rotation: 7, taille: 'm', class: 'bp-sticker--bande' -%}
  <ul class="bp-grille">
    {%- for position in vendor_order -%}
      {%- assign product_index = position | plus: 0 -%}
      {%- assign product = source.products[product_index] -%}
      <li>
        {% render 'bp-product-card',
          product: product,
          teinte: forloop.index,
          sizes: '(min-width: 90rem) 24vw, (min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw'
        %}
      </li>
    {%- endfor -%}
    {%- if s.show_pro and s.pro_title != blank -%}
      <li class="bp-grille__fin" style="--cellules-2: {{ span_2 }}; --cellules-3: {{ span_3 }}; --cellules-4: {{ span_4 }}">
        <p class="bp-grille__fin-titre">{{ s.pro_title | escape }}</p>
        {%- if s.pro_text != blank -%}
          <p class="bp-grille__fin-texte">{{ s.pro_text | escape }}</p>
        {%- endif -%}
        <a href="{{ s.pro_url | default: '/pages/espace-pro' | escape }}" class="bp-ui bp-carre bp-button" data-variant="plein">
          {{- s.pro_label | default: 'Espace pro' | escape -}}
        </a>
      </li>
    {%- endif -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "La sélection",
  "tag": "div",
  "class": "bp-selection-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit libellé au-dessus du titre", "default": "À boire maintenant" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La sélection" },
    { "type": "text", "id": "link_label", "label": "Lien vers la boutique", "default": "Toutes les bouteilles" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Sans choix, toutes les bouteilles." },
    { "type": "range", "id": "limit", "label": "Nombre maximum de bouteilles", "min": 3, "max": 24, "step": 1, "default": 12 },
    { "type": "header", "content": "Dernière cellule : les professionnels" },
    { "type": "checkbox", "id": "show_pro", "label": "Afficher la cellule pro", "default": true },
    { "type": "text", "id": "pro_title", "label": "Titre", "info": "Vide : pas de cellule.", "default": "Vous êtes pro ?" },
    { "type": "text", "id": "pro_text", "label": "Texte", "default": "Restaurants, cavistes, hôtels : demandez votre compte pro, nous l’étudions et vous prévenons par e-mail." },
    { "type": "text", "id": "pro_label", "label": "Bouton", "default": "Espace pro" },
    { "type": "text", "id": "pro_url", "label": "Lien du bouton", "default": "/pages/espace-pro" }
  ],
  "presets": [{ "name": "La sélection BluePoint" }]
}
{% endschema %}