{%- comment -%}
  Pied de page : une grande tuile marine arrondie, la marque à gauche, les colonnes de liens à droite.
  Coordonnées modifiables dans l’éditeur de thème.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phone_href = s.phone | remove: ' ' | prepend: 'tel:'
-%}

<footer id="contact" class="bp-footer">
  <div class="bp-footer__box">
    <div class="bp-footer__brand-cell">
      <a href="{{ routes.root_url }}" class="bp-footer__brand" aria-label="{{ shop.name | escape }}, accueil">
        {% render 'bp-logo', class: 'bp-footer__logo' %}
      </a>
      <address class="bp-ui bp-footer__address">
        {{ s.street | escape }}<br>
        {{ s.city | escape }}
      </address>
      <p class="bp-ui">{{ s.company | escape }} © {{ 'now' | date: '%Y' }}</p>
    </div>

    <div class="bp-ui bp-footer__columns">
      <div class="bp-footer__column">
        <h2 class="bp-footer__heading">Boutique</h2>
        <ul class="bp-footer__links">
          <li><a class="bp-footer__link" href="{{ routes.all_products_collection_url }}">Toutes les bouteilles</a></li>
          <li><a class="bp-footer__link" href="{{ routes.root_url }}#accords">Accords</a></li>
          <li><a class="bp-footer__link" href="{{ routes.cart_url }}">Panier</a></li>
        </ul>
      </div>

      <div class="bp-footer__column">
        <h2 class="bp-footer__heading">Maison</h2>
        <ul class="bp-footer__links">
          <li><a class="bp-footer__link" href="{{ routes.root_url }}#maison">À propos</a></li>
          {%- if s.wine_bar_url != blank -%}
            <li>
              <a class="bp-footer__link" href="{{ s.wine_bar_url | escape }}" target="_blank" rel="noopener noreferrer">
                {% render 'bp-icon-external', class: 'bp-footer__icon' %}Vintage Wine Bar<span class="bp-sr-only">(nouvel onglet)</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="bp-footer__column" data-large="true">
        <h2 class="bp-footer__heading">Contact</h2>
        <ul class="bp-footer__links">
          {%- if s.email != blank -%}
            <li>
              <a class="bp-footer__link bp-footer__link--email" href="mailto:{{ s.email | escape }}">
                {{- s.email | escape -}}
              </a>
            </li>
          {%- endif -%}
          {%- if s.phone != blank -%}
            <li>
              <a class="bp-footer__link" href="{{ phone_href | escape }}">
                {{- s.phone | escape -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="bp-footer__column">
        <h2 class="bp-footer__heading">Suivre</h2>
        <ul class="bp-footer__links">
          {%- if s.instagram_url != blank -%}
            <li>
              <a class="bp-footer__link" href="{{ s.instagram_url | escape }}" target="_blank" rel="noopener noreferrer">
                {% render 'bp-icon-external', class: 'bp-footer__icon' %}Instagram<span class="bp-sr-only">(nouvel onglet)</span>
              </a>
            </li>
          {%- endif -%}
          {%- if s.facebook_url != blank -%}
            <li>
              <a class="bp-footer__link" href="{{ s.facebook_url | escape }}" target="_blank" rel="noopener noreferrer">
                {% render 'bp-icon-external', class: 'bp-footer__icon' %}Facebook<span class="bp-sr-only">(nouvel onglet)</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- if shop.policies.size > 0 -%}
        <div class="bp-footer__column">
          <h2 class="bp-footer__heading">Légal</h2>
          <ul class="bp-footer__links">
            {%- for policy in shop.policies -%}
              {%- liquid
                case policy.handle
                  when 'privacy-policy'
                    assign policy_label = 'Confidentialité'
                  when 'refund-policy'
                    assign policy_label = 'Retours'
                  when 'terms-of-service'
                    assign policy_label = 'Conditions de vente'
                  when 'shipping-policy'
                    assign policy_label = 'Livraison'
                  when 'legal-notice'
                    assign policy_label = 'Mentions légales'
                  else
                    assign policy_label = policy.title
                endcase
              -%}
              <li><a class="bp-footer__link" href="{{ policy.url }}">{{ policy_label | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  <p class="bp-ui bp-footer__legal">
    L’abus d’alcool est dangereux pour la santé, à consommer avec modération. Vente réservée aux personnes de
    18&nbsp;ans et plus.
  </p>
</footer>

{% schema %}
{
  "name": "Pied de page BluePoint",
  "tag": "div",
  "class": "bp-footer-section",
  "settings": [
    { "type": "text", "id": "company", "label": "Raison sociale", "default": "Blue Point Distribution Sàrl" },
    { "type": "text", "id": "street", "label": "Rue", "default": "Rue du Châtelard 44" },
    { "type": "text", "id": "city", "label": "NPA, ville, pays", "default": "1095 Lutry, Suisse" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "info@bluepointdistribution.com" },
    { "type": "text", "id": "phone", "label": "Téléphone", "default": "+41 79 606 33 22" },
    { "type": "text", "id": "wine_bar_url", "label": "Lien Vintage Wine Bar", "default": "http://vintagewinebar.ch" },
    { "type": "text", "id": "instagram_url", "label": "Lien Instagram", "default": "https://www.instagram.com/bluepointdistribution" },
    { "type": "text", "id": "facebook_url", "label": "Lien Facebook", "default": "https://www.facebook.com/profile.php?id=100051131204556" }
  ]
}
{% endschema %}
