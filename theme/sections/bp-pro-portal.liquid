{%- comment -%}
  Espace pro : trois états selon le visiteur.
  1. Visiteur ou client particulier : connexion + demande de compte pro.
  2. Client connecté sans entreprise : explication + demande de rattachement.
  3. Professionnel connecté (compte B2B Shopify) : accueil, accès à la boutique.
  La remise pro est une remise automatique Shopify (« Prix pro -15 % », segment « Clients pro »,
  c’est-à-dire les clients marqués « pro ») : aucun prix n’est écrit dans le thème.
  Le catalogue B2B n’est pas utilisable sur l’abonnement Basic.
  Mise en page : à gauche, le titre et les conditions en quatre tuiles (elles restent à l’écran quand on remplit le
  formulaire) ; à droite, un seul cadre avec la connexion puis la demande de compte.
  La demande de compte part dans l'app de gestion (proxy d'app /apps/bon-commande/devenir-pro) : elle arrive dans
  « Clients pro », où le patron l'accepte en un toucher. Si une case est mal remplie, l'app réaffiche le formulaire
  avec le message à côté de la case. Les noms des champs doivent rester ceux de l'app (app/lib/pros/request.ts).
{%- endcomment -%}
{{ 'bp-pro-portal.css' | asset_url | stylesheet_tag }}
<style>
  /* Liste « Pays » : même pilule que les autres cases du formulaire. */
  .bp-pro__field select {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1.25rem;
    border: var(--trait) solid var(--encre);
    border-radius: var(--rayon-pilule);
    background: var(--c-blanc);
    color: var(--encre);
    font: inherit;
    font-size: 1rem;
  }
  .bp-pro__field select:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .bp-pro__form .bp-button[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
</style>

{%- liquid
  assign s = section.settings
  assign heading_id = 'bp-pro-title-' | append: section.id
  assign is_pro = false
  if customer and customer.b2b?
    assign is_pro = true
  endif
-%}

<section class="bp-pro" aria-labelledby="{{ heading_id }}">
  <div class="bp-pro__intro">
    <p class="bp-ui bp-pro__label">{{ s.label | escape }}</p>
    <h1 id="{{ heading_id }}" class="bp-pro__statement">
      {%- if is_pro -%}
        {{ s.welcome_title | escape }}
      {%- else -%}
        {{ s.statement | escape }}
      {%- endif -%}
    </h1>

    {%- if section.blocks.size > 0 -%}
      <ul class="bp-ui bp-phrase bp-pro__terms">
        {%- for block in section.blocks -%}
          <li class="bp-pro__term" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="bp-pro__panel">
    {%- if is_pro -%}
      <p class="bp-pro__company">
        <span class="bp-ui bp-pro__small">Vous êtes connecté à</span>
        <span class="bp-pro__company-name">{{ customer.current_company.name | escape }}</span>
        {%- if customer.current_location.name != blank and customer.current_location.name != customer.current_company.name -%}
          <span class="bp-pro__location">Lieu&#8239;: {{ customer.current_location.name | escape }}</span>
        {%- endif -%}
      </p>
      <p class="bp-pro__text">{{ s.welcome_text | escape }}</p>
      <div class="bp-pro__actions">
        <a href="{{ routes.all_products_collection_url }}" class="bp-ui bp-carre bp-button" data-variant="plein">{{ s.shop_label | escape }}</a>
        <a href="{{ routes.account_url }}" class="bp-ui bp-carre bp-button" data-variant="trait">Mes commandes</a>
      </div>
    {%- else -%}
      {%- if customer -%}
        <p class="bp-pro__text">{{ s.not_linked_text | escape }}</p>
      {%- else -%}
        <div class="bp-pro__login">
          <p class="bp-pro__text">{{ s.login_text | escape }}</p>
          <div class="bp-pro__actions">
            <a href="{{ routes.account_login_url }}?return_url={{ page.url | url_encode }}" class="bp-ui bp-carre bp-button" data-variant="plein">Se connecter</a>
          </div>
        </div>
      {%- endif -%}

      <h2 class="bp-ui bp-pro__form-title">{{ s.form_title | escape }}</h2>

      <form method="post" action="/apps/bon-commande/devenir-pro" id="bp-pro-form" class="bp-pro__form" accept-charset="UTF-8"
        onsubmit="var b=this.querySelector('button[type=submit]');if(b){if(b.disabled)return false;b.disabled=true;b.textContent='Envoi en cours…';}">
        <label class="bp-pro__field">
          <span class="bp-ui">Société</span>
          <input type="text" name="companyName" autocomplete="organization" required maxlength="70">
        </label>
        <div class="bp-pro__pair">
          <label class="bp-pro__field">
            <span class="bp-ui">Prénom</span>
            <input type="text" name="firstName" autocomplete="given-name" required maxlength="40"
              value="{{ customer.first_name | escape }}">
          </label>
          <label class="bp-pro__field">
            <span class="bp-ui">Nom</span>
            <input type="text" name="lastName" autocomplete="family-name" required maxlength="40"
              value="{{ customer.last_name | escape }}">
          </label>
        </div>
        <div class="bp-pro__pair">
          <label class="bp-pro__field">
            <span class="bp-ui">E-mail</span>
            <input type="email" name="email" autocomplete="email" required
              value="{{ customer.email | escape }}">
          </label>
          <label class="bp-pro__field">
            <span class="bp-ui">Téléphone</span>
            <input type="tel" name="phone" autocomplete="tel" required placeholder="079 123 45 67">
          </label>
        </div>
        <label class="bp-pro__field">
          <span class="bp-ui">Rue et numéro</span>
          <input type="text" name="street" autocomplete="street-address" required maxlength="70">
        </label>
        <div class="bp-pro__pair">
          <label class="bp-pro__field">
            <span class="bp-ui">NPA</span>
            <input type="text" name="postalCode" autocomplete="postal-code" required inputmode="numeric" pattern="[0-9]{4}" maxlength="4">
          </label>
          <label class="bp-pro__field">
            <span class="bp-ui">Localité</span>
            <input type="text" name="city" autocomplete="address-level2" required maxlength="35">
          </label>
        </div>
        <div class="bp-pro__pair">
          <label class="bp-pro__field">
            <span class="bp-ui">Pays</span>
            <select name="country" autocomplete="country">
              <option value="CH" selected>Suisse</option>
              <option value="LI">Liechtenstein</option>
            </select>
          </label>
          <label class="bp-pro__field">
            <span class="bp-ui">Numéro TVA (facultatif)</span>
            <input type="text" name="vatNumber" placeholder="CHE-123.456.789 TVA">
          </label>
        </div>
        <label class="bp-pro__field">
          <span class="bp-ui">Votre activité (facultatif)</span>
          <textarea name="message" rows="3" maxlength="500"></textarea>
        </label>
        {%- comment -%} Piège à robots : invisible pour les visiteurs, laissé vide. {%- endcomment -%}
        <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden">
          <label>Ne pas remplir <input type="text" name="site_web" tabindex="-1" autocomplete="off"></label>
        </div>

        {%- comment -%} L'envoi prend quelques secondes : le bouton se bloque après le premier clic. {%- endcomment -%}
        <button type="submit" class="bp-ui bp-carre bp-button" data-variant="plein">Envoyer la demande</button>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Espace pro",
  "tag": "div",
  "class": "bp-pro-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Intitulé", "default": "Espace pro" },
    { "type": "textarea", "id": "statement", "label": "Titre (visiteur)", "default": "Restaurants, cavistes, entreprises : commandez avec la remise pro." },
    { "type": "textarea", "id": "login_text", "label": "Texte de connexion", "default": "Vous avez déjà un compte pro ? Connectez-vous : votre remise s’applique ensuite au panier." },
    { "type": "text", "id": "form_title", "label": "Titre du formulaire", "default": "Demander un compte pro" },
    { "type": "textarea", "id": "success_text", "label": "Message après envoi", "default": "Merci, votre demande est bien partie. Nous revenons vers vous pour ouvrir votre compte." },
    { "type": "textarea", "id": "not_linked_text", "label": "Texte (connecté sans entreprise)", "default": "Votre compte n’est pas encore rattaché à une entreprise. Envoyez-nous votre demande, nous l’ouvrons ensuite." },
    { "type": "header", "content": "Professionnel connecté" },
    { "type": "text", "id": "welcome_title", "label": "Titre", "default": "Bienvenue dans votre espace pro." },
    { "type": "textarea", "id": "welcome_text", "label": "Texte", "default": "Votre remise professionnelle de 15 % s’applique automatiquement au panier, tant que vous êtes connecté." },
    { "type": "text", "id": "shop_label", "label": "Bouton boutique", "default": "Commander" }
  ],
  "blocks": [
    {
      "type": "condition",
      "name": "Condition",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Prix professionnels" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Espace pro",
      "blocks": [
        { "type": "condition", "settings": { "text": "Remise professionnelle de 15 % au panier" } },
        { "type": "condition", "settings": { "text": "Cartons de 6 et 12 bouteilles" } },
        { "type": "condition", "settings": { "text": "Paiement sur facture" } }
      ]
    }
  ]
}
{% endschema %}