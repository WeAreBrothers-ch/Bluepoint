{%- comment -%}
  « Questions fréquentes » : des pastilles bleu ciel qui s'ouvrent au toucher (blocs « question »).
  Natif : <details>, sans script. La section n'apparaît pas sans bloc.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'bp-faq-title-' | append: section.id
-%}

{%- if section.blocks.size > 0 -%}
{{ 'bp-faq.css' | asset_url | stylesheet_tag }}

<section id="faq" class="bp-section" aria-labelledby="{{ heading_id }}">
  {% render 'bp-section-head', id: heading_id, title: s.title, kicker: s.kicker %}
  <div class="bp-faq">
    {%- for block in section.blocks -%}
      <details class="bp-faq__item" {{ block.shopify_attributes }}>
        <summary class="bp-faq__question">
          <span>{{ block.settings.question | escape }}</span>
          <span class="bp-faq__marque" aria-hidden="true"></span>
        </summary>
        <div class="bp-faq__reponse">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Questions fréquentes",
  "tag": "div",
  "class": "bp-faq-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit libellé au-dessus du titre", "default": "On vous répond" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Questions fréquentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Une question ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Écrivez-nous, Paolo vous répond.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [
        { "type": "question", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "<p>Livraison sous 48 h en Suisse, offerte dès 24 bouteilles.</p>" } },
        { "type": "question", "settings": { "question": "Puis-je commander une seule bouteille ?", "answer": "<p>Oui, à l’unité ou en carton de 3, 6 ou 12.</p>" } }
      ]
    }
  ]
}
{% endschema %}