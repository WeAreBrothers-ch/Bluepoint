{%- comment -%}
  « La maison » : la photo de Paolo légendée « Paolo Pioletti », puis son histoire
  (demande du 15/11 : la photo de Paolo remplace « À la vigne » et « Les étiquettes » ;
  sur ordinateur, photo et texte forment deux cases de même taille, voir bp-house-story.css).
  Les coordonnées (e-mail, téléphone) ne sont écrites qu’une fois, dans le pied de page.
  Le texte montre son premier paragraphe, le reste se déplie avec « Lire la suite » (demande d'Eliott du 13/11 :
  trop de texte d'un coup sur téléphone). Menu déroulant natif (<details>) : marche sans JavaScript.
{%- endcomment -%}
{{ 'bp-house-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign heading_id = 'bp-maison-title-' | append: section.id
  assign body_first = s.body | split: '</p>' | first | append: '</p>'
  assign body_rest = s.body | remove_first: body_first | strip
-%}

<section id="maison" class="bp-section" aria-labelledby="{{ heading_id }}">
  {% render 'bp-section-head', id: heading_id, title: s.title %}
  <div class="bp-house">
    <div class="bp-house__gallery">
      {% render 'bp-photo-figure',
        image: s.photo_1,
        fallback: 'bp-photo-paolo.webp',
        width: 1200,
        height: 1600,
        alt: s.photo_1_alt,
        caption: s.photo_1_caption,
        ratio: '1 / 1',
        sizes: '(min-width: 64rem) 46vw, 92vw'
      %}
    </div>

    <div class="bp-house__text">
      <p class="bp-affiche bp-house__title">{{ s.heading | escape }}</p>
      <div class="bp-house__body">
        {%- if body_rest != blank -%}
          {{ body_first }}
          <details class="bp-house__suite">
            <summary class="bp-ui bp-house__lire">
              <span class="bp-house__lire-ferme">Lire la suite</span><span class="bp-house__lire-ouvert">Réduire</span>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false" class="bp-house__plus"><path d="M1 6h10"/><path class="bp-house__plus-v" d="M6 1v10"/></svg>
            </summary>
            <div class="bp-house__body">{{ body_rest }}</div>
          </details>
        {%- else -%}
          {{ s.body }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "La maison",
  "tag": "div",
  "class": "bp-house-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre de section", "default": "La maison" },
    { "type": "text", "id": "heading", "label": "Accroche", "default": "Paolo, à Lutry, depuis 2003" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texte",
      "default": "<p>Paolo Pioletti importe des vins italiens depuis 2003. Après des années à chercher des vignerons attachés au travail artisanal, il s’est ouvert aux vins suisses. Depuis 2020, il s’y consacre entièrement.</p><p>De petits domaines d’Italie et de Suisse romande, et une relation directe avec chaque vigneron.</p>"
    },
    { "type": "header", "content": "Photo", "info": "Sans photo choisie, la photo de Paolo devant la camionnette s’affiche." },
    { "type": "image_picker", "id": "photo_1", "label": "Photo" },
    { "type": "text", "id": "photo_1_alt", "label": "Description", "default": "Paolo Pioletti, souriant, appuyé contre la camionnette BluePoint Distribution dans une rue de Lutry" },
    { "type": "text", "id": "photo_1_caption", "label": "Légende", "default": "Paolo Pioletti" }
  ],
  "presets": [{ "name": "La maison BluePoint" }]
}
{% endschema %}
