# Copier ce fichier en .env pour le développement local (jamais versionné).
# Sur Vercel, renseigner ces valeurs dans Project Settings → Environment Variables.

# --- Shopify (Dev Dashboard → app BluePoint Gestion → Settings) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Doit correspondre à [access_scopes] de shopify.app.toml
SCOPES=read_customers,read_draft_orders,read_fulfillments,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,read_metaobjects,read_orders,read_payment_terms,read_products,read_publications,write_customers,write_draft_orders,write_fulfillments,write_inventory,write_merchant_managed_fulfillment_orders,write_metaobjects,write_order_edits,write_orders,write_payment_terms,write_products,write_publications
# URL publique de l'app (ex. https://bluepoint-gestion.vercel.app). Remplie par la CLI en dev.
SHOPIFY_APP_URL=

# --- Base de données (Neon via Vercel Marketplace) ---
# Connexion « pooled » utilisée par l'app
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Connexion directe utilisée par `prisma migrate` (fournie par Neon sous ce nom)
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# --- E-mails (Resend) ---
RESEND_API_KEY=

# --- Stockage des factures PDF ---
INVOICE_STORAGE_PROVIDER=vercel-blob
INVOICE_STORAGE_TOKEN=
INVOICE_STORAGE_BUCKET=
